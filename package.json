{
  "name": "svelte-widgets",
  "version": "1.12.0",
  "description": "Accessible, keyboard-friendly Svelte components and attachments",
  "keywords": [
    "accessibility",
    "attachments",
    "command-palette",
    "components",
    "masonry",
    "multi-select",
    "popover",
    "svelte",
    "sveltekit",
    "table-of-contents",
    "toast",
    "typescript",
    "ui"
  ],
  "homepage": "https://svelte-widgets.janosh.dev",
  "bugs": "https://github.com/janosh/svelte-widgets/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-widgets",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/code-editor/editor.css",
    "./dist/heading-anchors.css",
    "./dist/highlight/theme.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#site": "./src/site/index.ts",
    "#site/*": "./src/site/*",
    "#root/*": "./*"
  },
  "exports": {
    "./CodeEditor.svelte": {
      "types": "./dist/code-editor/CodeEditor.svelte.d.ts",
      "svelte": "./dist/code-editor/CodeEditor.svelte",
      "default": "./dist/code-editor/CodeEditor.svelte"
    },
    "./DiffView.svelte": {
      "types": "./dist/code-editor/DiffView.svelte.d.ts",
      "svelte": "./dist/code-editor/DiffView.svelte",
      "default": "./dist/code-editor/DiffView.svelte"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "default": "./dist/attachments/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./position": {
      "types": "./dist/position.d.ts",
      "default": "./dist/position.js"
    },
    "./shortcuts": {
      "types": "./dist/shortcuts.d.ts",
      "default": "./dist/shortcuts.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "default": "./dist/match.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    },
    "./vite-config": {
      "types": "./dist/vite-config.d.ts",
      "default": "./dist/vite-config.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./icons/builders": {
      "types": "./dist/icons/builders.d.ts",
      "default": "./dist/icons/builders.js"
    },
    "./heading-anchors": {
      "types": "./dist/heading-anchors.d.ts",
      "default": "./dist/heading-anchors.js"
    },
    "./heading-anchors.css": {
      "default": "./dist/heading-anchors.css"
    },
    "./labels": {
      "types": "./dist/labels.d.ts",
      "default": "./dist/labels.js"
    },
    "./highlight": {
      "types": "./dist/highlight/index.d.ts",
      "default": "./dist/highlight/index.js"
    },
    "./highlight/theme.css": {
      "default": "./dist/highlight/theme.css"
    },
    "./source-links": {
      "types": "./dist/source-links/index.d.ts",
      "default": "./dist/source-links/index.js"
    },
    "./source-links/vite-plugin": {
      "types": "./dist/source-links/vite-plugin.d.ts",
      "default": "./dist/source-links/vite-plugin.js"
    },
    "./source-links/virtual": {
      "types": "./dist/source-links/virtual.d.ts"
    },
    "./prop-docs/vite-plugin": {
      "types": "./dist/prop-docs/vite-plugin.d.ts",
      "default": "./dist/prop-docs/vite-plugin.js"
    },
    "./prop-docs/virtual": {
      "types": "./dist/prop-docs/virtual.d.ts"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "svelte": "./dist/code-editor/index.js",
      "default": "./dist/code-editor/index.js"
    },
    "./code-editor/editor.css": {
      "default": "./dist/code-editor/editor.css"
    },
    "./dialogs": {
      "types": "./dist/dialogs.svelte.d.ts",
      "default": "./dist/dialogs.svelte.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./figure-export": {
      "types": "./dist/figure-export.d.ts",
      "default": "./dist/figure-export.js"
    },
    "./file-drop": {
      "types": "./dist/file-drop.d.ts",
      "default": "./dist/file-drop.js"
    },
    "./find-in-page": {
      "types": "./dist/find-in-page.svelte.d.ts",
      "default": "./dist/find-in-page.svelte.js"
    },
    "./text-search": {
      "types": "./dist/text-search.d.ts",
      "default": "./dist/text-search.js"
    },
    "./toast-queue": {
      "types": "./dist/toast-queue.svelte.d.ts",
      "default": "./dist/toast-queue.svelte.js"
    },
    "./theme": {
      "types": "./dist/theme.svelte.d.ts",
      "default": "./dist/theme.svelte.js"
    },
    "./theme-core": {
      "types": "./dist/theme-core.d.ts",
      "default": "./dist/theme-core.js"
    },
    "./JsonTree.svelte": {
      "types": "./dist/json-tree/JsonTree.svelte.d.ts",
      "svelte": "./dist/json-tree/JsonTree.svelte",
      "default": "./dist/json-tree/JsonTree.svelte"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "default": "./dist/virtual.js"
    },
    "./json-tree": {
      "types": "./dist/json-tree/index.d.ts",
      "default": "./dist/json-tree/index.js"
    },
    "./json-tree/utils": {
      "types": "./dist/json-tree/utils.d.ts",
      "default": "./dist/json-tree/utils.js"
    },
    "./json-tree/path": {
      "types": "./dist/json-tree/path.d.ts",
      "default": "./dist/json-tree/path.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "svelte": "./dist/table/index.js",
      "default": "./dist/table/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./roving-focus": {
      "types": "./dist/roving-focus.svelte.d.ts",
      "default": "./dist/roving-focus.svelte.js"
    },
    "./canvas": {
      "types": "./dist/canvas.svelte.d.ts",
      "default": "./dist/canvas.svelte.js"
    },
    "./effects": {
      "types": "./dist/effects.svelte.d.ts",
      "default": "./dist/effects.svelte.js"
    },
    "./sequence-player": {
      "types": "./dist/sequence-player.svelte.d.ts",
      "default": "./dist/sequence-player.svelte.js"
    },
    "./worker-client": {
      "types": "./dist/worker-client.svelte.d.ts",
      "default": "./dist/worker-client.svelte.js"
    },
    "./worker-serve": {
      "types": "./dist/worker-serve.d.ts",
      "default": "./dist/worker-serve.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./markdown/vite": {
      "types": "./dist/markdown/vite.d.ts",
      "default": "./dist/markdown/vite.js"
    },
    "./markdown/content": {
      "types": "./dist/markdown/content.d.ts",
      "default": "./dist/markdown/content.js"
    },
    "./markdown/check": {
      "types": "./dist/markdown/check.d.ts",
      "default": "./dist/markdown/check.js"
    },
    "./markdown/mermaid": {
      "types": "./dist/markdown/mermaid.d.ts",
      "default": "./dist/markdown/mermaid.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:site": "vp build",
    "test": "vp test run && playwright test",
    "test:coverage": "vp test run --coverage",
    "test:package": "npm run package && node scripts/test-package.ts",
    "package": "npm run gen:icons && svelte-package && node scripts/finalize-package.ts",
    "prepare": "vp config --no-agent && npm run package",
    "prepublishOnly": "npm run package",
    "gen:icons": "node scripts/generate-icons.ts"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/gis": "^1.2.6",
    "@iconify-json/iconoir": "^1.2.12",
    "@iconify-json/lucide": "^1.2.160",
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/octicon": "^1.2.41",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.104",
    "@iconify-json/zondicons": "^1.2.2",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^26.6.11",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitest/coverage-v8": "5.1.2",
    "@wooorm/starry-night": "^3.11.0",
    "happy-dom": "21.0.4",
    "mermaid": "^12.4.0",
    "pagefind": "^1.6.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "temml": "^0.14.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0",
    "vscode-oniguruma": "^2.0.1"
  },
  "peerDependencies": {
    "@wooorm/starry-night": "^3.0.0",
    "mermaid": "^12.0.0",
    "svelte": "^5.48.0",
    "temml": "^0.14.0",
    "typescript": "^5.0.0 || ^6.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@wooorm/starry-night": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "temml": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "svelte": "$svelte",
    "vite": "$vite",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18 || >=23.6"
    }
  }
}
