{
  "name": "svelte-widgets",
  "version": "1.8.0",
  "description": "Accessible, keyboard-friendly Svelte components and attachments",
  "keywords": [
    "accessibility",
    "attachments",
    "command-palette",
    "components",
    "masonry",
    "multi-select",
    "popover",
    "svelte",
    "sveltekit",
    "table-of-contents",
    "toast",
    "typescript",
    "ui"
  ],
  "homepage": "https://svelte-widgets.janosh.dev",
  "bugs": "https://github.com/janosh/svelte-widgets/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-widgets",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/code-editor/editor.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    "./CodeEditor.svelte": {
      "types": "./dist/code-editor/CodeEditor.svelte.d.ts",
      "svelte": "./dist/code-editor/CodeEditor.svelte",
      "default": "./dist/code-editor/CodeEditor.svelte"
    },
    "./DiffView.svelte": {
      "types": "./dist/code-editor/DiffView.svelte.d.ts",
      "svelte": "./dist/code-editor/DiffView.svelte",
      "default": "./dist/code-editor/DiffView.svelte"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "default": "./dist/attachments/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    },
    "./vite-config": {
      "types": "./dist/vite-config.d.ts",
      "default": "./dist/vite-config.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./heading-anchors": {
      "types": "./dist/heading-anchors.d.ts",
      "default": "./dist/heading-anchors.js"
    },
    "./labels": {
      "types": "./dist/labels.d.ts",
      "default": "./dist/labels.js"
    },
    "./highlight": {
      "types": "./dist/highlight/index.d.ts",
      "default": "./dist/highlight/index.js"
    },
    "./source-links": {
      "types": "./dist/source-links/index.d.ts",
      "default": "./dist/source-links/index.js"
    },
    "./source-links/vite-plugin": {
      "types": "./dist/source-links/vite-plugin.d.ts",
      "default": "./dist/source-links/vite-plugin.js"
    },
    "./source-links/virtual": {
      "types": "./dist/source-links/virtual.d.ts"
    },
    "./clipboard": {
      "types": "./dist/clipboard.svelte.d.ts",
      "default": "./dist/clipboard.svelte.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "svelte": "./dist/code-editor/index.js",
      "default": "./dist/code-editor/index.js"
    },
    "./code-editor/editor.css": {
      "default": "./dist/code-editor/editor.css"
    },
    "./dialogs": {
      "types": "./dist/dialogs.svelte.d.ts",
      "default": "./dist/dialogs.svelte.js"
    },
    "./file-drop": {
      "types": "./dist/file-drop.d.ts",
      "default": "./dist/file-drop.js"
    },
    "./find-in-page": {
      "types": "./dist/find-in-page.svelte.d.ts",
      "default": "./dist/find-in-page.svelte.js"
    },
    "./fullscreen": {
      "types": "./dist/fullscreen.svelte.d.ts",
      "default": "./dist/fullscreen.svelte.js"
    },
    "./print": {
      "types": "./dist/print.d.ts",
      "default": "./dist/print.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./text-search": {
      "types": "./dist/text-search.d.ts",
      "default": "./dist/text-search.js"
    },
    "./toast-queue": {
      "types": "./dist/toast-queue.svelte.d.ts",
      "default": "./dist/toast-queue.svelte.js"
    },
    "./theme": {
      "types": "./dist/theme.svelte.d.ts",
      "default": "./dist/theme.svelte.js"
    },
    "./JsonTree.svelte": {
      "types": "./dist/json-tree/JsonTree.svelte.d.ts",
      "svelte": "./dist/json-tree/JsonTree.svelte",
      "default": "./dist/json-tree/JsonTree.svelte"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "default": "./dist/virtual.js"
    },
    "./json-tree": {
      "types": "./dist/json-tree/index.d.ts",
      "default": "./dist/json-tree/index.js"
    },
    "./json-tree/utils": {
      "types": "./dist/json-tree/utils.d.ts",
      "default": "./dist/json-tree/utils.js"
    },
    "./json-tree/path": {
      "types": "./dist/json-tree/path.d.ts",
      "default": "./dist/json-tree/path.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "default": "./dist/csv.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./roving-focus": {
      "types": "./dist/roving-focus.svelte.d.ts",
      "default": "./dist/roving-focus.svelte.js"
    },
    "./canvas": {
      "types": "./dist/canvas.svelte.d.ts",
      "default": "./dist/canvas.svelte.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "default": "./dist/stats.js"
    },
    "./url-params": {
      "types": "./dist/url-params.d.ts",
      "default": "./dist/url-params.js"
    },
    "./image-markup": {
      "types": "./dist/image-markup.d.ts",
      "default": "./dist/image-markup.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./markdown/vite": {
      "types": "./dist/markdown/vite.d.ts",
      "default": "./dist/markdown/vite.js"
    },
    "./markdown/content": {
      "types": "./dist/markdown/content.d.ts",
      "default": "./dist/markdown/content.js"
    },
    "./markdown/check": {
      "types": "./dist/markdown/check.d.ts",
      "default": "./dist/markdown/check.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:site": "vp build",
    "test": "vitest run && playwright test",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run package && node scripts/test-package.ts",
    "package": "npm run gen:icons && svelte-package && node scripts/finalize-package.ts",
    "prepare": "vp config --no-agent && npm run package",
    "prepublishOnly": "npm run package",
    "gen:icons": "node --experimental-strip-types scripts/generate-icons.ts"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/carbon": "^1.2.26",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/gis": "^1.2.5",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/material-symbols": "^1.2.90",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/octicon": "^1.2.32",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/zondicons": "^1.2.2",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.0",
    "@wooorm/starry-night": "^3.11.0",
    "happy-dom": "20.14.0",
    "katex": "^0.18.7",
    "pagefind": "^1.5.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plus": "0.3.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@wooorm/starry-night": "^3.0.0",
    "katex": "^0.16.0 || ^0.17.0 || ^0.18.0",
    "svelte": "^5.48.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@wooorm/starry-night": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "svelte": "$svelte"
  }
}
