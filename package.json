{
  "name": "svelte-widgets",
  "version": "1.5.0",
  "description": "Accessible, keyboard-friendly Svelte components and attachments",
  "keywords": [
    "accessibility",
    "attachments",
    "command-palette",
    "components",
    "masonry",
    "multi-select",
    "popover",
    "svelte",
    "sveltekit",
    "table-of-contents",
    "toast",
    "typescript",
    "ui"
  ],
  "homepage": "https://svelte-widgets.janosh.dev",
  "bugs": "https://github.com/janosh/svelte-widgets/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-widgets",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/code-editor/editor.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    "./DiffView.svelte": {
      "types": "./dist/code-editor/DiffView.svelte.d.ts",
      "svelte": "./dist/code-editor/DiffView.svelte",
      "default": "./dist/code-editor/DiffView.svelte"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "default": "./dist/attachments/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./vite-config": {
      "types": "./dist/vite-config.d.ts",
      "default": "./dist/vite-config.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./heading-anchors": {
      "types": "./dist/heading-anchors.d.ts",
      "default": "./dist/heading-anchors.js"
    },
    "./katex": {
      "types": "./dist/katex.d.ts",
      "default": "./dist/katex.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./live-examples": {
      "types": "./dist/live-examples/index.d.ts",
      "default": "./dist/live-examples/index.js"
    },
    "./live-examples/create-highlighter": {
      "types": "./dist/live-examples/create-highlighter.d.ts",
      "default": "./dist/live-examples/create-highlighter.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.svelte.d.ts",
      "default": "./dist/clipboard.svelte.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "svelte": "./dist/code-editor/index.js",
      "default": "./dist/code-editor/index.js"
    },
    "./code-editor/editor.css": {
      "default": "./dist/code-editor/editor.css"
    },
    "./dialogs": {
      "types": "./dist/dialogs.svelte.d.ts",
      "default": "./dist/dialogs.svelte.js"
    },
    "./file-drop": {
      "types": "./dist/file-drop.d.ts",
      "default": "./dist/file-drop.js"
    },
    "./find-in-page": {
      "types": "./dist/find-in-page.svelte.d.ts",
      "default": "./dist/find-in-page.svelte.js"
    },
    "./fullscreen": {
      "types": "./dist/fullscreen.svelte.d.ts",
      "default": "./dist/fullscreen.svelte.js"
    },
    "./print": {
      "types": "./dist/print.d.ts",
      "default": "./dist/print.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./text-search": {
      "types": "./dist/text-search.d.ts",
      "default": "./dist/text-search.js"
    },
    "./toast-queue": {
      "types": "./dist/toast-queue.svelte.d.ts",
      "default": "./dist/toast-queue.svelte.js"
    },
    "./theme": {
      "types": "./dist/theme.svelte.d.ts",
      "default": "./dist/theme.svelte.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:site": "vp build && pagefind --site build --exclude-selectors \"pre, details\"",
    "test": "vp test --run && playwright test",
    "test:coverage": "vp test --run --coverage",
    "test:package": "npm pack --dry-run && tsc -p tests/package-smoke/tsconfig.json && vp build --config tests/package-smoke/vite.config.ts",
    "package": "npm run gen:icons && svelte-package && find dist \\( -name '*.js' -o -name '*.d.ts' -o -name '*.svelte' \\) -type f -exec perl -pi -e \"s/(\\.\\.?\\/[^'\\\"]*)\\.ts(['\\\"])/\\1.js\\2/g; s{((?:from|import)\\s*(?:\\(\\s*)?['\\\"])(\\.\\.?\\/(?:[^\\/'\\\"]+\\/)*[^\\/.'\\\"]+)(['\\\"])}{\\1\\2.js\\3}g\" {} + && find dist -name 'readme.svelte' -delete",
    "prepare": "npm run package",
    "prepublishOnly": "npm run package",
    "changelog": "npx tsx https://raw.githubusercontent.com/janosh/workflows/HEAD/scripts/make-release-notes.ts",
    "gen:icons": "node --experimental-strip-types scripts/generate-icons.ts"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/gis": "^1.2.5",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lucide": "^1.2.122",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/octicon": "^1.2.32",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/zondicons": "^1.2.2",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.4",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "@wooorm/starry-night": "^3.10.0",
    "happy-dom": "^20.11.2",
    "katex": "^0.18.3",
    "mdsvex": "^0.12.8",
    "pagefind": "^1.5.2",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plus": "0.2.8"
  },
  "peerDependencies": {
    "@wooorm/starry-night": "^3.0.0",
    "katex": "^0.16.0 || ^0.17.0 || ^0.18.0",
    "svelte": "^5.48.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@wooorm/starry-night": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "svelte": "$svelte"
  }
}
